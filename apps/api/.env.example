DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
DEVELOPMENT_API_URL=http://localhost:3001
PRODUCTION_API_URL=https://your-api.example.com

# Google Cloud OAuth client of type Web application. Never expose the secret in mobile env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=

APPLE_CLIENT_SECRET=
