DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
CORS_ORIGINS=http://localhost:8081
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
API_PORT=3001
API_INSPECTOR_PORT=9229

# Use 0.0.0.0 for physical-device development on your local network.
API_HOST=127.0.0.1
# Google Cloud OAuth client of type Web application. Never expose the secret in mobile env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=

APPLE_CLIENT_SECRET=
