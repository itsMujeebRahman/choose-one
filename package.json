{
  "name": "choose-one",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run start --workspace @choose-one/mobile --",
    "dev:mobile": "npm run start --workspace @choose-one/mobile --",
    "dev:api": "npm run dev --workspace @choose-one/api --",
    "android": "npm run android --workspace @choose-one/mobile --",
    "ios": "npm run ios --workspace @choose-one/mobile --",
    "web": "npm run web --workspace @choose-one/mobile --",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps --ignore-pattern \"**/dist/**\"",
    "start:api": "npm run start --workspace @choose-one/api --",
    "neon:deploy": "npm run neon:deploy --workspace @choose-one/api"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "@types/node": "^22.0.0"
  }
}
